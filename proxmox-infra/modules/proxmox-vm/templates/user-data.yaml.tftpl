#cloud-config
# Ce snippet remplace intégralement le user-data généré par Proxmox : le nom
# d'hôte doit donc y être redéfini, sans quoi la VM reste sur « localhost ».
hostname: ${hostname}
%{ if fqdn != "" ~}
fqdn: ${fqdn}
# Conserve le nom court pour `hostname`, le FQDN n'allant que dans /etc/hosts.
prefer_fqdn_over_hostname: false
%{ endif ~}
manage_etc_hosts: true
package_update: ${package_update}
package_upgrade: ${package_upgrade}
packages:
  - qemu-guest-agent
users:
  - name: ${cloud_init_user}
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true
%{ if length(user_groups) > 0 ~}
    groups: [${join(", ", user_groups)}]
%{ endif ~}
%{ if length(ssh_keys) > 0 ~}
    ssh_authorized_keys:
%{ for key in ssh_keys ~}
      - ${key}
%{ endfor ~}
%{ endif ~}
runcmd:
  - systemctl enable --now qemu-guest-agent
